						<td><cdac:property value="phoneno"/></td><td><cdac:property value="payment"/></td>
						<td><cdac:property value="transdetails"/></td><td><cdac:property value="status"/></td>
						</tr>
					</cdac:iterator>
				</tbody>
			</table>
			<button type="button" id="buttonExport" class="btn btn-info btn-mini pull-right" onclick="tableToExcel('accept', 'Confirmed List')">Save As Excel</button>
